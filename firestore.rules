rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══ USERS (Private user profiles) ══
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId && validateUser(request.resource.data);
      allow create: if request.auth != null && validateUser(request.resource.data);
    }

    // ══ CREDENTIALS (Login only - public read) ══
    match /credentials/{username} {
      allow read: if true; // Public read for login only
      allow write: if request.auth != null; // Only authenticated users can write
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ══ GUILD CONFIGURATION ══
    match /guild/{document=**} {
      allow read: if true; // Public read
      allow write: if request.auth != null; // Any authenticated user can write
    }

    // ══ GUILD MEMBERS ══
    match /guilds/{guildId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ══ PUBLIC GUILD INFO ══
    match /guilds/{guildId} {
      allow read: if true; // Public info
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ══ MESSAGES / CHAT ══
    match /guilds/{guildId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validateMessage(request.resource.data);
      allow update: if request.auth.uid == resource.data.userId && validateMessage(request.resource.data);
      allow delete: if request.auth.uid == resource.data.userId;
    }

    // ══ FEEDBACKS ══
    match /feedback/{feedbackId} {
      allow read: if true; // Public read
      allow create: if request.auth != null && validateFeedback(request.resource.data);
      allow update: if request.auth != null; // Any authenticated user can update
      allow delete: if request.auth != null;
    }

    // ══ HELPER FUNCTIONS ══
    function validateUser(data) {
      return data.size() > 0 &&
        data.keys().hasAll(['username', 'email']) &&
        data.username is string &&
        data.email is string &&
        data.username.size() > 0 &&
        data.email.size() > 5;
    }

    function validateMessage(data) {
      return data.size() > 0 &&
        data.keys().hasAll(['text', 'userId']) &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() < 2000 &&
        data.userId == request.auth.uid;
    }

    function validateFeedback(data) {
      return data.size() > 0 &&
        data.keys().hasAll(['category', 'title', 'message']) &&
        data.category is string &&
        data.title is string &&
        data.message is string &&
        data.title.size() > 0 &&
        data.title.size() < 100 &&
        data.message.size() > 0 &&
        data.message.size() < 2000;
    }
  }
}
